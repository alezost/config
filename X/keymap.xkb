// -*- mode: c++ -*-

// This is a modern way to configure keyboard for X server (replacement
// for "xmodmap").  This file should be loaded by "xkbcomp".  The base
// structure was generated by "setxkbmap -print".

xkb_keymap {
  xkb_keycodes  { include "evdev+aliases(qwerty)" };
  xkb_types     { include "complete" };
  xkb_compat    { include "complete" };
  xkb_geometry  { include "pc(pc104)" };

  xkb_symbols   { include "pc+us(dvorak)+ru:2+us:3+inet(evdev)+keypad(pointerkeys)+group(rctrl_rshift_toggle)"

    // Key names and codes: </usr/share/X11/xkb/keycodes/evdev>.
    key <CAPS> {[ Kanji          ]};
    key <MENU> {[ Hyper_R        ]};
    key <I213> {[ XF86LogOff     ]};
    key <I120> {[ XF86Documents  ]};
    key <I164> {[ XF86Pictures   ]};
    key <I221> {[ XF86Music      ]};
    key <I223> {[ XF86Spell      ]};
    // key <PRSC> {[ XF86ScreenSaver]};

    modifier_map Mod3 { Hyper_R };
    modifier_map Mod4 { Super_L };
  };
};
